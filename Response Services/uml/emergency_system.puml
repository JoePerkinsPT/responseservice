@startuml Emergency Response System

' Define skin parameters for better visualization
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classBackgroundColor LightBlue
skinparam classBorderColor DarkBlue

' Define classes
class Allocator {
    - incidents: List<Incident>
    - resources: List<Resource>
    + add_incident(incident: Incident)
    + add_resource(resource: Resource)
    + calculate_distance(loc1: str, loc2: str): int
    + allocate_resources()
    - _reallocate_for(incident: Incident, req_type: str, needed: int)
    + update_incident_priority(incident_id: str, new_priority: str)
}

class Incident {
    - id: str
    - type: str
    - priority: str
    - location: str
    - status: str
    - required_resources: List[Tuple[str, int]]
    - assigned_resources: List[Resource]
    + update_priority(new_priority: str)
    + is_allocated(): bool
}

class Resource {
    - id: str
    - type: str
    - location: str
    - assigned_to: Optional[Incident]
    + assign(incident: Incident)
    + release()
    + is_available(): bool
}

' Define relationships
Allocator "1" *-- "many" Incident : manages
Allocator "1" *-- "many" Resource : manages
Incident "many" o-- "many" Resource : requires

' Add notes for important concepts
note right of Allocator
  Priority levels:
  High = 0
  Medium = 1
  Low = 2
end note

note right of Incident
  Status values:
  - Pending
  - Assigned
end note

note right of Resource
  Resource types:
  - Ambulance
  - FireTruck
  - PoliceCar
end note

@enduml 